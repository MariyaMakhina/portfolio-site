43d\\u043e \\u0434\\u0443\\u0431\\u043b\\u0438\\u0440\\u043e\\u0432\\u0430\\u0442\\u044c \\u0432 Telegram \\u0438\\u043b\\u0438 \\u043d\\u0430 email. \\u0412\\u0441\\u0451 \\u043d\\u0430\\u0441\\u0442\\u0440\\u0430\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u0434 \\u0432\\u0430\\u0448 \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u0439 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441.</p>\", \"image\": null, \"image_position\": \"left\", \"image_width\": \"40\"}, \"id\": \"fbdff5df-96e5-4028-a537-eaa3e1e1fc58\"}, {\"type\": \"content_with_icon\", \"value\": {\"title\": \"\\u0412\\u0441\\u0451 \\u043f\\u043e\\u0434 \\u0432\\u0430\\u0448 \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441\", \"icon\": \"\\ud83d\\udccc\", \"icon_svg\": 102, \"text\": \"<p data-block-key=\\\"jhosi\\\">\\u0421\\u0430\\u0439\\u0442 \\u043d\\u0435 \\u0437\\u0430\\u0448\\u0438\\u0442 \\u0432 \\u0431\\u0435\\u0442\\u043e\\u043d\\u0435. Wagtail \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u044f\\u0442\\u044c \\u043b\\u044e\\u0431\\u044b\\u0435 \\u0444\\u0443\\u043d\\u043a\\u0446\\u0438\\u0438. \\u0421\\u0430\\u0439\\u0442 \\u0440\\u0430\\u0441\\u0442\\u0451\\u0442 \\u0432\\u043c\\u0435\\u0441\\u0442\\u0435 \\u0441 \\u0432\\u0430\\u0448\\u0438\\u043c \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441\\u043e\\u043c. \\u041d\\u043e\\u0432\\u044b\\u0435 \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u044b, \\u043d\\u0435\\u0441\\u0442\\u0430\\u043d\\u0434\\u0430\\u0440\\u0442\\u043d\\u044b\\u0435 \\u0431\\u043b\\u043e\\u043a\\u0438, \\u0438\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0438\\u0438 \\u2014 \\u0432\\u0441\\u0451 \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u0443\\u0435\\u0442\\u0441\\u044f \\u0431\\u0435\\u0437 \\u043f\\u0435\\u0440\\u0435\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432\\u0441\\u0435\\u0433\\u043e \\u043a\\u043e\\u0434\\u0430.</p>\", \"image\": null, \"image_position\": \"lef