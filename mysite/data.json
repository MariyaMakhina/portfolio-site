447\\u0451\\u0440\\u043a\\u0438\\u0432\\u0430\\u0435\\u043c \\u0433\\u043b\\u0430\\u0432\\u043d\\u043e\\u0435. \\u0412\\u0430\\u0448\\u0438 \\u0444\\u043e\\u0442\\u043e \\u0431\\u0443\\u0434\\u0443\\u0442 \\u0432\\u044b\\u0433\\u043b\\u044f\\u0434\\u0435\\u0442\\u044c \\u0441\\u0432\\u0435\\u0436\\u043e \\u0438 \\u0441\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e, \\u043d\\u043e \\u0431\\u0435\\u0437 \\u044d\\u0444\\u0444\\u0435\\u043a\\u0442\\u0430 \\u00ab\\u0434\\u0435\\u0448\\u0451\\u0432\\u043e\\u0433\\u043e HDR\\u00bb.</p>\", \"id\": \"12706563-7fcc-4aa9-ae8d-412c45d4205d\"}, {\"type\": \"text_block\", \"value\": \"<p data-block-key=\\\"p42rb\\\"></p><embed embedtype=\\\"image\\\" format=\\\"right\\\" id=\\\"24\\\" alt=\\\"check2-all24\\\"/><h3 data-block-key=\\\"7m1b3\\\"><b>\\u0413\\u043e\\u0442\\u043e\\u0432\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442</b></h3><p data-block-key=\\\"mit2\\\">\\u0412\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0435 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0444\\u043e\\u0442\\u043e \\u0432 \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u043c \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0438, \\u0433\\u043e\\u0442\\u043e\\u0432\\u044b\\u0435 \\u0434\\u043b\\u044f \\u043f\\u0435\\u0447\\u0430\\u0442\\u0438, \\u0441\\u0430\\u0439\\u0442\\u0430 \\u0438 \\u0441\\u043e\\u0446\\u0441\\u0435\\u0442\\u0435\\u0439. \\u0410 \\u0433\\u043b\\u0430\\u0432\\u043d\\u043e\\u0435 \\u2014 \\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0441\\u0442\\u0432\\u043e, \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0435 \\u0445\\u043e\\u0447\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c.</p>\", \"id\": \"9d40de14-2420-4028-acf9-db325a1cf7ce\"}]",
      "team_title": "Команда",
      "team_subtitle": "Люди, которые создают эту красоту",
      "team_members": "[{\"type\": \"member\", \"value\": {\"name\": \"\\u0410\\u043d\\u043d\\u0430 \\u0412\\u043e\\u043b\\u043a\\u043e\\u0432\\u0430\", \"position\": \"\\u041e\\u0441\\u043d\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u0438 \\u0433\\u043b\\u0430\\u0432\\u043d\\u044b\\u0439 \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\", \"description\": \"\\u0410\\u043d\\u043d\\u0430 \\u0437\\u0430\\u0434\\u0430\\u0451\\u0442 \\u0442\\u043e\\u043d \\u0438 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0432\\u0441\\u0435\\u043c \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430\\u043c. \\u041d\\u0430\\u0447\\u0438\\u043d\\u0430\\u043b\\u0430 \\u043a\\u0430\\u043a \\u0440\\u0435\\u043f\\u043e\\u0440\\u0442\\u0430\\u0436\\u043d\\u044b\\u0439 \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444, \\u043d\\u043e \\u0431\\u044b\\u0441\\u0442\\u0440\\u043e \\u043d\\u0430\\u0448\\u043b\\u0430 \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0438\\u043d\\u0442\\u0435\\u0440\\u044c\\u0435\\u0440\\u043d\\u043e\\u0439 \\u0438 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u043e\\u0439 \\u0441\\u044a\\u0451\\u043c\\u043a\\u0435. \\u041e\\u0431\\u043e\\u0436\\u0430\\u0435\\u0442 \\u0443\\u0442\\u0440\\u0435\\u043d\\u043d\\u0438\\u0439 \\u0441\\u0432\\u0435\\u0442 \\u0438 \\u043c\\u0438\\u043d\\u0438\\u043c\\u0430\\u043b\\u0438\\u0437\\u043c \\u0432 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0434\\u0435\\u0442\\u0430\\u043b\\u0438.\", \"photo\": 48}, \"id\": \"716efcd2-f1a6-4046-a36b-f370ca3b9b19\"}, {\"type\": \"member\", \"value\": {\"name\": \"\\u0414\\u043c\\u0438\\u0442\\u0440\\u0438\\u0439 \\u041d\\u043e\\u0432\\u0438\\u043a\\u043e\\u0432\", \"position\": \"\\u0410\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0439 \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\", \"description\": \"\\u0414\\u043c\\u0438\\u0442\\u0440\\u0438\\u0439 \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0435\\u0442 \\u0437\\u0430 \\u0433\\u0435\\u043e\\u043c\\u0435\\u0442\\u0440\\u0438\\u044e \\u0438 \\u043b\\u0438\\u043d\\u0438\\u0438. \\u0415\\u0433\\u043e \\u043a\\u0430\\u0434\\u0440\\u044b \\u2014 \\u044d\\u0442\\u043e \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u0438\\u0434\\u0435\\u0430\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0432\\u0435\\u0440\\u0442\\u0438\\u043a\\u0430\\u043b\\u0438, \\u0447\\u0451\\u0442\\u043a\\u0438\\u0435 \\u043a\\u043e\\u043c\\u043f\\u043e\\u0437\\u0438\\u0446\\u0438\\u0438 \\u0438 \\u0431\\u0435\\u0437\\u0443\\u043f\\u0440\\u0435\\u0447\\u043d\\u044b\\u0439 \\u0441\\u0432\\u0435\\u0442. \\u0411\\u0435\\u0437 \\u043d\\u0435\\u0433\\u043e \\u043d\\u0438 \\u043e\\u0434\\u0438\\u043d \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442 \\u043d\\u0435 \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0435\\u0442\\u0441\\u044f: \\u043e\\u043d \\u043e\\u0442\\u0432\\u0435\\u0447\\u0430\\u0435\\u0442 \\u0437\\u0430 \\u0442\\u0435\\u0445\\u043d\\u0438\\u0447\\u0435\\u0441\\u043a\\u0443\\u044e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443 \\u0441\\u044a\\u0451\\u043c\\u043a\\u0438 \\u0438 \\u043f\\u043e\\u0441\\u0442\\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0443.\", \"photo\": 46}, \"id\": \"fcdb56cd-08c4-4601-a8c7-0735f4a0b6ba\"}, {\"type\": \"member\", \"value\": {\"name\": \"\\u0415\\u043b\\u0435\\u043d\\u0430 \\u041c\\u043e\\u0440\\u043e\\u0437\\u043e\\u0432\\u0430\", \"position\": \"\\u0421\\u0442\\u0438\\u043b\\u0438\\u0441\\u0442 \\u0438 \\u043f\\u0440\\u043e\\u0434\\u044e\\u0441\\u0435\\u0440\", \"description\": \"\\u0415\\u043b\\u0435\\u043d\\u0430 \\u0433\\u043e\\u0442\\u043e\\u0432\\u0438\\u0442 \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442\\u044b \\u043a \\u0441\\u044a\\u0451\\u043c\\u043a\\u0435: \\u0440\\u0430\\u0441\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442\\u044b, \\u043f\\u043e\\u0434\\u0431\\u0438\\u0440\\u0430\\u0435\\u0442 \\u0434\\u0435\\u0442\\u0430\\u043b\\u0438, \\u043a\\u043e\\u043e\\u0440\\u0434\\u0438\\u043d\\u0438\\u0440\\u0443\\u0435\\u0442 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0443 \\u0438 \\u043e\\u0431\\u0449\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441 \\u0437\\u0430\\u043a\\u0430\\u0437\\u0447\\u0438\\u043a\\u0430\\u043c\\u0438. \\u0411\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u044f \\u0435\\u0439 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043a\\u0430\\u0434\\u0440 \\u0432\\u044b\\u0433\\u043b\\u044f\\u0434\\u0438\\u0442 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e \\u043a\\u0440\\u0430\\u0441\\u0438\\u0432\\u043e, \\u0430 \\u043f\\u0440\\u043e\\u0434\\u0443\\u043c\\u0430\\u043d\\u043d\\u043e \\u0434\\u043e \\u043c\\u0435\\u043b\\u043e\\u0447\\u0435\\u0439.\", \"photo\": 47}, \"id\": \"6567dcce-88ff-4d7c-9272-f817d2e1af16\"}, {\"type\": \"member\", \"value\": {\"name\": \"\\u0418\\u0433\\u043e\\u0440\\u044c \\u0421\\u043e\\u043a\\u043e\\u043b\\u043e\\u0432\", \"position\": \"\\u0412\\u0438\\u0434\\u0435\\u043e\\u0433\\u0440\\u0430\\u0444 \\u0438 \\u0440\\u0435\\u0442\\u0443\\u0448\\u0451\\u0440\", \"description\": \"\\u0418\\u0433\\u043e\\u0440\\u044c \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432\\u0438\\u0434\\u0435\\u043e\\u0441\\u043e\\u043f\\u0440\\u043e\\u0432\\u043e\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435\\u043c \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u043e\\u0432 \\u0438 \\u0444\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u043e\\u0439. \\u0415\\u0433\\u043e \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u043a \\u0446\\u0432\\u0435\\u0442\\u0443 \\u0438 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u0430\\u043c \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 \\u043d\\u0430\\u0448\\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0443\\u0437\\u043d\\u0430\\u0432\\u0430\\u0435\\u043c\\u044b\\u043c\\u0438. \\u0415\\u0441\\u043b\\u0438 \\u0444\\u043e\\u0442\\u043e \\u043d\\u0443\\u0436\\u043d\\u043e \\u00ab\\u043e\\u0436\\u0438\\u0432\\u0438\\u0442\\u044c\\u00bb \\u2014 \\u044d\\u0442\\u043e \\u043a \\u043d\\u0435\\u043c\\u0443.\", \"photo\": 45}, \"id\": \"6b03af00-bee2-45af-b372-858c9b683fc8\"}]",
      "footer_text": "<p data-block-key=\"zlnv8\"><b>Мы гордимся тем, что делаем, и любим свою работу. Если вы хотите работать с профессионалами, которые понимают свет, линии и атмосферу, — напишите нам. Будем рады новым проектам.</b></p>",
