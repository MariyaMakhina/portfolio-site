      "team_members": "[{\"type\": \"member\", \"value\": {\"name\": \"\\u0410\\u043d\\u043d\\u0430 \\u0412\\u043e\\u043b\\u043a\\u043e\\u0432\\u0430\", \"position\": \"\\u041e\\u0441\\u043d\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u0438 \\u0433\\u043b\\u0430\\u0432\\u043d\\u044b\\u0439 \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\", \"description\": \"\\u0410\\u043d\\u043d\\u0430 \\u0437\\u0430\\u0434\\u0430\\u0451\\u0442 \\u0442\\u043e\\u043d \\u0438 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0432\\u0441\\u0435\\u043c \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430\\u043c. \\u041d\\u0430\\u0447\\u0438\\u043d\\u0430\\u043b\\u0430 \\u043a\\u0430\\u043a \\u0440\\u0435\\u043f\\u043e\\u0440\\u0442\\u0430\\u0436\\u043d\\u044b\\u0439 \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444, \\u043d\\u043e \\u0431\\u044b\\u0441\\u0442\\u0440\\u043e \\u043d\\u0430\\u0448\\u043b\\u0430 \\u0441\\u0435\\u0431\\u044f \\u0432 \\u0438\\u043d\\u0442\\u0435\\u0440\\u044c\\u0435\\u0440\\u043d\\u043e\\u0439 \\u0438 \\u0430\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u043e\\u0439 \\u0441\\u044a\\u0451\\u043c\\u043a\\u0435. \\u041e\\u0431\\u043e\\u0436\\u0430\\u0435\\u0442 \\u0443\\u0442\\u0440\\u0435\\u043d\\u043d\\u0438\\u0439 \\u0441\\u0432\\u0435\\u0442 \\u0438 \\u043c\\u0438\\u043d\\u0438\\u043c\\u0430\\u043b\\u0438\\u0437\\u043c \\u0432 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0434\\u0435\\u0442\\u0430\\u043b\\u0438.\", \"photo\": 48}, \"id\": \"716efcd2-f1a6-4046-a36b-f370ca3b9b19\"}, {\"type\": \"member\", \"value\": {\"name\": \"\\u0414\\u043c\\u0438\\u0442\\u0440\\u0438\\u0439 \\u041d\\u043e\\u0432\\u0438\\u043a\\u043e\\u0432\", \"position\": \"\\u0410\\u0440\\u0445\\u0438\\u0442\\u0435\\u043a\\u0442\\u0443\\u0440\\u043d\\u044b\\u0439 \\u0444\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444\", \"description\": \"\\u0414\\u043c\\u0438\\u0442\\u0440\\u0438\\u0439 \\u043e\\u0442\\u0432