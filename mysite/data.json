      "content": "[{\"type\": \"content_block\", \"value\": {\"title\": \"\\u0412 \\u0447\\u0451\\u043c \\u0446\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u044d\\u0442\\u043e\\u0433\\u043e \\u0441\\u0430\\u0439\\u0442\\u0430?\", \"description\": \"<p data-block-key=\\\"wntxa\\\">\\u0424\\u043e\\u0442\\u043e\\u0433\\u0440\\u0430\\u0444 \\u0438\\u043b\\u0438 \\u0441\\u0442\\u0443\\u0434\\u0438\\u044f \\u0441\\u0430\\u043c\\u0438 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u044f\\u044e\\u0442 \\u043f\\u043e\\u0440\\u0442\\u0444\\u043e\\u043b\\u0438\\u043e \\u0438 \\u0431\\u043b\\u043e\\u0433\\u043e\\u043c \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043f\\u0430\\u043d\\u0435\\u043b\\u044c \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f Wagtail. \\u041d\\u043e\\u0432\\u0430\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u043f\\u043e\\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 \\u0437\\u0430 2 \\u043c\\u0438\\u043d\\u0443\\u0442\\u044b. \\u0421\\u0442\\u0430\\u0442\\u044c\\u044f \\u043f\\u0443\\u0431\\u043b\\u0438\\u043a\\u0443\\u0435\\u0442\\u0441\\u044f \\u0437\\u0430 3 \\u043c\\u0438\\u043d\\u0443\\u0442\\u044b. \\u0417\\u0430\\u044f\\u0432\\u043a\\u0438 \\u043d\\u0430 \\u0441\\u044a\\u0451\\u043c\\u043a\\u0443 \\u043f\\u0440\\u0438\\u0445\\u043e\\u0434\\u044f\\u0442 \\u0441\\u0440\\u0430\\u0437\\u0443 \\u0432 \\u043f\\u0430\\u043d\\u0435\\u043b\\u044c \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0438 \\u043d\\u0430 email. \\u041f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u043c\\u0438\\u0441\\u0442 \\u043d\\u0435 \\u043d\\u0443\\u0436\\u0435\\u043d \\u2014 \\u043d\\u0438 \\u0434\\u043b\\u044f \\u043e\\u0431\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u0438\\u0439, \\u043d\\u0438 \\u0434\\u043b\\u044f \\u043f\\u0440\\u0430\\u0432\\u043e\\u043a.</p><p data-block-key=\\\"2i8as\\\"><b>\\u0427\\u0442\\u043e \\u0443\\u043c\\u0435\\u0435\\u0442 \\u044d\\u0442\\u043e\\u0442 \\u0441\\u0430\\u0439\\u0442:</b></p><ul><li data-block-key=\\\"1j4lh\\\">\\u041f\\u043e\\u0440\\u0442\\u0444\\u043e\\u043b\\u0438\\u043e \\u0441 \\u0444\\u0438\\u043b\\u044c\\u0442\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 \\u043f\\u043e \\u043a\\u0430\\u0442\\u0435\\u0433\\u043e\\u0440\\u0438\\u044f\\u043c \\u2014 \\u043a\\u043b\\u0438\\u0435\\u043d\\u0442\\u044b \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u044e\\u0442 \\u043d\\u0443\\u0436\\u043d\\u043e\\u0435</li><li data-block-key=\\\"b7jaf\\\">\\u0411\\u043b\\u043e\\u0433 \\u0441\\u043e \\u0441\\u0442\\u0430\\u0442\\u044c\\u044f\\u043c\\u0438 \\u0438 \\u0442\\u0435\\u0433\\u0430\\u043c\\u0438 \\u2014 \\u043f\\u043e\\u043c\\u043e\\u0433\\u0430\\u0435\\u0442 SEO \\u0438 \\u0434\\u043e\\u0432\\u0435\\u0440\\u0438\\u044e</li><li data-block-key=\\\"8jo1g\\\">\\u0424\\u043e\\u0440\\u043c\\u0430 \\u0437\\u0430\\u043a\\u0430\\u0437\\u0430 \\u0441\\u044a\\u0451\\u043c\\u043a\\u0438 \\u2014 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f \\u0438 \\u043d\\u0435 \\u0442\\u0435\\u0440\\u044f\\u044e\\u0442\\u0441\\u044f</li><li data-block-key=\\\"2d4so\\\">\\u041a\\u0430\\u0440\\u0442\\u0430 \\u0441 \\u0440\\u0430\\u0441\\u043f\\u043e\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435\\u043c \\u0441\\u0442\\u0443\\u0434\\u0438\\u0438 \\u2014 \\u043a\\u043b\\u0438\\u0435\\u043d\\u0442\\u044b \\u0432\\u0438\\u0434\\u044f\\u0442, \\u0433\\u0434\\u0435 \\u0432\\u044b \\u043d\\u0430\\u0445\\u043e\\u0434\\u0438\\u0442\\u0435\\u0441\\u044c</li><li data-block-key=\\\"ai0iu\\\">\\u0410\\u0434\\u0430\\u043f\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d \\u2014 \\u043d\\u0430 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u0435</li></ul><p data-block-key=\\\"a0jt4\\\"><b>\\u0420\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442:</b> \\u0441\\u0430\\u0439\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 \\u043a\\u0430\\u043a \\u043f\\u043e\\u043b\\u043d\\u043e\\u0446\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 \\u043f\\u0440\\u043e\\u0434\\u0430\\u0436, \\u0430 \\u043d\\u0435 \\u043a\\u0430\\u043a \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u043d\\u0430\\u044f \\u0432\\u0438\\u0437\\u0438\\u0442\\u043a\\u0430. \\u0412\\u044b \\u0437\\u0430\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442\\u0435\\u0441\\u044c \\u0441\\u044a\\u0451\\u043c\\u043a\\u0430\\u043c\\u0438, \\u0430 \\u043d\\u0435 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c \\u0441\\u0430\\u0439\\u0442\\u043e\\u043c.</p><p data-block-key=\\\"b24hp\\\"><b>\\u0410\\u043a\\u0446\\u0438\\u0438, \\u0438\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0441 \\u0441\\u043e\\u0446\\u0441\\u0435\\u0442\\u044f\\u043c\\u0438?</b> Wagtail \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u044f\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u0434 \\u043b\\u044e\\u0431\\u044b\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0438 \\u0431\\u0438\\u0437\\u043d\\u0435\\u0441\\u0430.</p>\", \"image\": null}, \"id\": \"3f2c8571-6869-451c-b4fe-e83b18cfaa6f\"}, {\"type\": \"content_block\", \"value\": {\"title\": \"\\u041f\\u043e\\u0447\\u0435\\u043c\\u0443 \\u044d\\u0442\\u043e\\u0442 \\u0441\\u0430\\u0439\\u0442 \\u043d\\u0430 Wagtail.\", \"description\": \"<p data-block-key=\\\"5sucr\\\">Wagtail \\u2014 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f CMS (\\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u0430 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0441\\u0430\\u0439\\u0442\\u043e\\u043c). \\u0412 \\u043d\\u0435\\u0439 \\u0435\\u0441\\u0442\\u044c \\u0432\\u0441\\u0451 \\u0434\\u043b\\u044f \\u0444\\u043e\\u0442\\u043e\\u0441\\u0442\\u0443\\u0434\\u0438\\u0438: \\u043f\\u043e\\u0440\\u0442\\u0444\\u043e\\u043b\\u0438\\u043e, \\u0431\\u043b\\u043e\\u0433, \\u0444\\u043e\\u0440\\u043c\\u044b \\u0437\\u0430\\u044f\\u0432\\u043e\\u043a, \\u043d\\u0430\\u0441\\u0442\\u0440\\u043e\\u0439\\u043a\\u0438 SEO. \\u0410\\u0434\\u043c\\u0438\\u043d\\u043a\\u0430 \\u043f\\u043e\\u043d\\u044f\\u0442\\u043d\\u0430 \\u0441\\u043e\\u0442\\u0440\\u0443\\u0434\\u043d\\u0438\\u043a\\u0430\\u043c. \\u0412\\u044b \\u0432\\u043b\\u0430\\u0434\\u0435\\u0435\\u0442\\u0435 \\u0441\\u0430\\u0439\\u0442\\u043e\\u043c \\u043f\\u043e\\u043b\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u2014 \\u043a\\u043e\\u0434 \\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0432\\u0430\\u0448\\u0438. \\u041c\\u043e\\u0436\\u043d\\u043e \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u044f\\u0442\\u044c \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0444\\u0443\\u043d\\u043a\\u0446\\u0438\\u043e\\u043d\\u0430\\u043b \\u0431\\u0435\\u0437 \\u043f\\u0435\\u0440\\u0435\\u0434\\u0435\\u043b\\u043e\\u043a.</p>\", \"image\": null}, \"id\": \"58aa080f-a186-4faf-bd3f-e08a5e632131\"}, {\"type\": \"content_block\", \"value\": {\"title\": \"\\u041a\\u0430\\u043a \\u0443\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u043e \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435\", \"description\": \"\", \"image\": null}, \"id\": \"c2d56fa2-c366-49a4-8c0b-df3f6fcf4065\"}, {\"type\": \"content_with_icon\", \"value\": {\"title\": \"\\u041f\\u043e\\u0440\\u0442\\u0444\\u043e\\u043b\\u0438\\u043e \\u043f\\u043e\\u0434 \\u043a\\u043b\\u044e\\u0447\", \"icon\": \"\\ud83d\\udccc\", \"icon_svg\": 100, \"text\": \"<p data-block-key=\\\"fn4ue\\\">\\u0412 \\u043f\\u0430\\u043d\\u0435\\u043b\\u0438 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0432\\u044b \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442\\u0435 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u044b/\\u0441\\u0442\\u0430\\u0442\\u044c\\u0438: \\u0437\\u0430\\u0433\\u0440\\u0443\\u0436\\u0430\\u0435\\